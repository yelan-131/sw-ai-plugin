<UserControl x:Class="SwComAddin.Views.MainTaskPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:SwComAddin.Views"
             mc:Ignorable="d" FontFamily="Microsoft YaHei, Segoe UI"
             d:DesignHeight="600" d:DesignWidth="340">
    <UserControl.Resources>
        <!-- Underline Tab Style -->
        <Style x:Key="TabBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel>
                            <Border x:Name="Bd" Background="Transparent" Padding="6,8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Rectangle x:Name="Underline" Height="2" Fill="Transparent" Margin="2,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#0078D7"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter TargetName="Underline" Property="Fill" Value="#0078D7"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#F0F0F0"/>
                                <Setter Property="Foreground" Value="#333333"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#0078D7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DDDDDD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0078D7" Padding="12,10">
            <StackPanel>
                <TextBlock Text="SW AI Plugin" Foreground="White" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text="AI 驱动的参数化建模助手" Foreground="#B8D4F0" FontSize="10" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Tab Bar (5 tabs, underline style) -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Margin="2,0">
                    <RadioButton x:Name="TabParts" Content="标准件库" GroupName="Nav" IsChecked="True"
                                 Style="{StaticResource TabBtn}" Checked="TabParts_Checked"/>
                    <RadioButton x:Name="TabCustom" Content="自定义库" GroupName="Nav"
                                 Style="{StaticResource TabBtn}" Checked="TabCustom_Checked"/>
                    <RadioButton x:Name="TabParam" Content="参数建模" GroupName="Nav"
                                 Style="{StaticResource TabBtn}" Checked="TabParam_Checked"/>
                    <RadioButton x:Name="TabAI" Content="智能助手" GroupName="Nav"
                                 Style="{StaticResource TabBtn}" Checked="TabAI_Checked"/>
                    <RadioButton x:Name="TabSettings" Content="系统设置" GroupName="Nav"
                                 Style="{StaticResource TabBtn}" Checked="TabSettings_Checked"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="2">
            <!-- Page 1: 标准件库 (Standard Parts) -->
            <ScrollViewer x:Name="PageParts" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <!-- Search bar -->
                    <Border Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="2" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PartsSearch" BorderThickness="0" Padding="8,5" FontSize="11"
                                     Foreground="#999999" Background="Transparent"
                                     GotFocus="PartsSearch_GotFocus" LostFocus="PartsSearch_LostFocus"
                                     Text="搜索零件..." KeyDown="PartsSearch_KeyDown"/>
                            <TextBlock Grid.Column="1" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                       Foreground="#999999" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 3-level TreeView (templates set in code-behind) -->
                    <TreeView x:Name="PartsTree" Background="White" Foreground="#333333"
                              BorderBrush="#E0E0E0" BorderThickness="1" MaxHeight="250"
                              Padding="2" FontSize="12" Margin="0,0,0,0"
                              TreeViewItem.Expanded="PartsTree_Expanded"/>

                    <!-- Part Detail Card -->
                    <Border x:Name="PartDetailBorder" Background="White" BorderBrush="#E0E0E0"
                            BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,8,0,0"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="PartName" FontSize="13" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,4"/>
                            <Border Background="#E6F0FA" CornerRadius="2" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,6">
                                <TextBlock x:Name="PartStandard" FontSize="10" Foreground="#0078D7"/>
                            </Border>
                            <TextBlock x:Name="PartDesc" FontSize="11" Foreground="#777777" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <!-- Specs Table -->
                            <ItemsControl x:Name="PartSpecs" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Key}" FontSize="10" Foreground="#888888"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="10" Foreground="#333333" FontWeight="Medium"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- 3D Schematic Preview -->
                            <views:PartPreviewView x:Name="PartPreview" Margin="0,0,0,8"/>

                            <!-- Parametric editing panel (shown for geometric parts) -->
                            <Border x:Name="ParamEditPanel" Background="#F8F8F8" BorderBrush="#D0D0D0"
                                    BorderThickness="1" CornerRadius="2" Padding="8" Margin="0,0,0,8"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="参数设置（可修改）" FontSize="11" FontWeight="Bold"
                                               Foreground="#333333" Margin="0,0,0,6"/>
                                    <ItemsControl x:Name="PartParamInputs">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="80"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" FontSize="10">
                                                        <Run Text="{Binding Label, Mode=OneWay}" Foreground="#444444"/>
                                                        <Run Text=" [" Foreground="#AAAAAA" FontSize="9"/>
                                                        <Run Text="{Binding Unit, Mode=OneWay}" Foreground="#AAAAAA" FontSize="9"/>
                                                        <Run Text="]" Foreground="#AAAAAA" FontSize="9"/>
                                                    </TextBlock>
                                                    <TextBox Grid.Column="1" Text="{Binding Value}"
                                                             Style="{StaticResource InputBox}" FontSize="10" Padding="4,3"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Generate button for parametric parts -->
                            <Button x:Name="GeneratePartBtn" Content="生成模型" Click="GeneratePartBtn_Click"
                                    Style="{StaticResource PrimaryBtn}" Padding="0,7" Visibility="Collapsed"/>
                            <TextBlock x:Name="GenerateResultText" FontSize="10" Margin="0,6,0,0"
                                       TextWrapping="Wrap" Visibility="Collapsed"/>

                            <Button x:Name="InsertBtn" Content="插入到 SolidWorks" Click="InsertBtn_Click"
                                    Style="{StaticResource PrimaryBtn}" Padding="0,7"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Page 2: 自定义库 (Custom Library) -->
            <ScrollViewer x:Name="PageCustom" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="8">
                    <!-- My Parts Section -->
                    <TextBlock Text="我的零件" FontSize="13" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="添加零件" Click="AddCustomPart_Click"
                                Style="{StaticResource PrimaryBtn}" Padding="10,4" Margin="0,0,6,0"/>
                        <Button Content="删除" Click="DeleteCustomPart_Click"
                                Style="{StaticResource SecondaryBtn}" Padding="10,4"/>
                    </StackPanel>
                    <ListBox x:Name="CustomPartsList" Height="120" FontSize="11" Margin="0,0,0,12"
                             BorderBrush="#E0E0E0" BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" Foreground="#333333"/>
                                    <TextBlock FontSize="10" Foreground="#999999">
                                        <Run Text="{Binding Category, Mode=OneWay}"/>
                                        <Run Text=" | "/>
                                        <Run Text="{Binding Standard, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- My Templates Section -->
                    <TextBlock Text="我的模板" FontSize="13" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="添加模板" Click="AddCustomTemplate_Click"
                                Style="{StaticResource PrimaryBtn}" Padding="10,4" Margin="0,0,6,0"/>
                        <Button Content="删除" Click="DeleteCustomTemplate_Click"
                                Style="{StaticResource SecondaryBtn}" Padding="10,4"/>
                    </StackPanel>
                    <ListBox x:Name="CustomTemplatesList" Height="120" FontSize="11"
                             BorderBrush="#E0E0E0" BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" Foreground="#333333"/>
                                    <TextBlock FontSize="10" Foreground="#999999">
                                        <Run Text="{Binding Parameters.Count, Mode=OneWay}"/>
                                        <Run Text=" 个参数"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Page 3: 参数建模 (Parametric Modeling) -->
            <ScrollViewer x:Name="PageParam" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="8">
                    <TextBlock Text="参数化建模" FontSize="13" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,8"/>
                    <TextBlock Text="选择模板类型" FontSize="11" Foreground="#888888" Margin="0,0,0,4"/>
                    <ComboBox x:Name="TemplateCombo" FontSize="12" Margin="0,0,0,10" Padding="6,4"
                              BorderBrush="#CCCCCC" SelectionChanged="TemplateCombo_SelectionChanged"/>

                    <ItemsControl x:Name="ParamInputs">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#E8E8E8" BorderThickness="1"
                                        CornerRadius="2" Padding="8,6" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" FontSize="11">
                                            <Run Text="{Binding Label, Mode=OneWay}" Foreground="#444444" FontWeight="Medium"/>
                                            <Run Text=" [" Foreground="#AAAAAA" FontSize="10"/>
                                            <Run Text="{Binding Unit, Mode=OneWay}" Foreground="#AAAAAA" FontSize="10"/>
                                            <Run Text="]" Foreground="#AAAAAA" FontSize="10"/>
                                        </TextBlock>
                                        <TextBox Grid.Column="1" Width="80"
                                                 Text="{Binding Value}"
                                                 Style="{StaticResource InputBox}" FontSize="11" Padding="6,4"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button x:Name="GenerateBtn" Content="生成模型" Click="GenerateBtn_Click"
                            IsEnabled="False" Style="{StaticResource PrimaryBtn}"
                            Padding="0,8" Margin="0,4,0,0"/>

                    <TextBlock x:Name="ResultText" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Page 4: 智能助手 (AI Assistant) -->
            <Grid x:Name="PageAI" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Padding="8">
                    <ItemsControl x:Name="ChatList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Bg}" CornerRadius="4" Padding="10" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Fg}" FontSize="11" TextWrapping="Wrap" LineHeight="18"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="1" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AiInput" Style="{StaticResource InputBox}"
                                 KeyDown="AiInput_KeyDown"/>
                        <Button Grid.Column="1" x:Name="AiSendBtn" Content="发送" Click="AiSendBtn_Click"
                                Style="{StaticResource PrimaryBtn}" Padding="12,5" Margin="6,0,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Page 5: 系统设置 (Settings) -->
            <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="8">
                    <TextBlock Text="系统设置" FontSize="14" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,10"/>

                    <!-- AI 服务配置 -->
                    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="&#xE946; AI 服务配置" FontSize="12" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,8"/>
                            <TextBlock Text="API 密钥" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="ApiKeyInput" Background="White" Foreground="#333333"
                                         BorderBrush="#CCCCCC" BorderThickness="1" Padding="8,5" FontSize="12" PasswordChar="*" Margin="0,0,0,4"/>
                            <TextBlock x:Name="ApiKeyStatus" Text="" FontSize="10" Foreground="#888888" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="保存" Click="SaveApiKey_Click" Style="{StaticResource PrimaryBtn}" Padding="16,4" Margin="0,0,6,0"/>
                                <Button Content="验证" Click="TestApiKey_Click" Style="{StaticResource SecondaryBtn}" Padding="12,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 后端服务 -->
                    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="&#xE968; 后端服务" FontSize="12" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,8"/>
                            <TextBlock Text="服务地址" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                            <TextBox x:Name="BackendUrlInput" Style="{StaticResource InputBox}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="BackendUrlStatus" Text="" FontSize="10" Foreground="#888888" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="保存并重连" Click="SaveBackendUrl_Click" Style="{StaticResource PrimaryBtn}" Padding="12,4" Margin="0,0,6,0"/>
                                <Button Content="刷新状态" Click="RefreshStatus_Click" Style="{StaticResource SecondaryBtn}" Padding="12,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 显示设置 -->
                    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="&#xE722; 显示设置" FontSize="12" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ShowPreviewCheck" Content="显示零件预览图" IsChecked="True" FontSize="11" Foreground="#444444" Margin="0,0,0,4"/>
                            <CheckBox x:Name="ShowDimensionsCheck" Content="显示尺寸标注" IsChecked="True" FontSize="11" Foreground="#444444" Margin="0,0,0,4"/>
                            <CheckBox x:Name="AutoExpandTreeCheck" Content="自动展开零件树" IsChecked="False" FontSize="11" Foreground="#444444"/>
                        </StackPanel>
                    </Border>

                    <!-- SolidWorks 集成 -->
                    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="&#xE90F; SolidWorks 集成" FontSize="12" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,8"/>
                            <CheckBox x:Name="AutoInsertCheck" Content="插入后自动打开零件" IsChecked="True" FontSize="11" Foreground="#444444" Margin="0,0,0,4"/>
                            <CheckBox x:Name="ShowTaskPaneCheck" Content="启动时自动显示面板" IsChecked="True" FontSize="11" Foreground="#444444" Margin="0,0,0,4"/>
                            <TextBlock Text="默认单位" FontSize="11" Foreground="#666666" Margin="0,6,0,4"/>
                            <ComboBox x:Name="DefaultUnitCombo" FontSize="11" Padding="6,4" BorderBrush="#CCCCCC">
                                <ComboBoxItem Content="毫米 (mm)" IsSelected="True"/>
                                <ComboBoxItem Content="厘米 (cm)"/>
                                <ComboBoxItem Content="英寸 (inch)"/>
                            </ComboBox>
                            <TextBlock Text="模型库路径" FontSize="11" Foreground="#666666" Margin="0,8,0,4"/>
                            <TextBlock Text="(存放 STEP/IGES 等外部模型文件的文件夹)" FontSize="9" Foreground="#999999" Margin="0,0,0,4"/>
                            <TextBox x:Name="ModelLibPathInput" Style="{StaticResource InputBox}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="ModelLibStatus" Text="" FontSize="10" Foreground="#888888" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="保存路径" Click="SaveModelLibPath_Click" Style="{StaticResource SecondaryBtn}" Padding="12,4" Margin="0,0,6,0"/>
                                <Button Content="打开文件夹" Click="OpenModelLibFolder_Click" Style="{StaticResource SecondaryBtn}" Padding="12,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 连接状态 -->
                    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="&#xEC27; 连接状态" FontSize="12" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="后端服务" Foreground="#888888" FontSize="11"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Ellipse x:Name="BackendDot" Width="7" Height="7" Fill="#C62828" Margin="0,3,5,0"/>
                                    <TextBlock x:Name="BackendStatus" Text="检测中..." Foreground="#FF8F00" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="SolidWorks" Foreground="#888888" FontSize="11"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Ellipse x:Name="SwDot" Width="7" Height="7" Fill="#C62828" Margin="0,3,5,0"/>
                                    <TextBlock x:Name="SwStatus" Text="未连接" Foreground="#C62828" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="API Key" Foreground="#888888" FontSize="11"/>
                                <TextBlock x:Name="ApiKeyConfigStatus" Text="检测中..." Foreground="#FF8F00" FontSize="11" Grid.Column="1"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 关于 -->
                    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="2" Padding="10">
                        <StackPanel>
                            <TextBlock Text="&#xE946; 关于" FontSize="12" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,4"/>
                            <TextBlock Text="SW AI Plugin v1.0" FontSize="11" Foreground="#888888" Margin="0,0,0,2"/>
                            <TextBlock Text="AI 驱动的 SolidWorks 参数化建模助手" FontSize="10" Foreground="#AAAAAA" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer Status Bar -->
        <Border Grid.Row="3" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Row 0: status bar (normal or update) -->
                <Grid Grid.Row="0">
                    <!-- Normal status bar -->
                    <Grid x:Name="StatusBar" Margin="8,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="FooterVersion" Text="v1.0.0" FontSize="9" Foreground="#AAAAAA"
                                       VerticalAlignment="Center" Cursor="Hand" MouseDown="FooterVersion_MouseDown"/>
                            <TextBlock Text="  │  " FontSize="9" Foreground="#DDDDDD" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusAI" Text="AI ✓" FontSize="9" Foreground="#4CAF50" VerticalAlignment="Center"/>
                            <TextBlock Text="  " FontSize="9" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusParts" Text="标准件 ✓" FontSize="9" Foreground="#4CAF50" VerticalAlignment="Center"/>
                            <TextBlock Text="  " FontSize="9" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusLib" Text="模型库 ✓" FontSize="9" Foreground="#4CAF50" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="FooterSettingsBtn" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,2"
                                Click="FooterSettingsBtn_Click" ToolTip="系统设置">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#888888"/>
                        </Button>
                    </Grid>
                    <!-- Update notification bar (hidden by default) -->
                    <Grid x:Name="UpdateBar" Margin="8,4" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="UpdateVersionText" Text="" FontSize="9" Foreground="#C62828" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="UpdateActionLink" Text=" 点击更新" FontSize="9" Foreground="#0078D7" Cursor="Hand"
                                       TextDecorations="Underline" VerticalAlignment="Center" MouseDown="UpdateActionLink_MouseDown"/>
                            <TextBlock Text="  │  " FontSize="9" Foreground="#DDDDDD" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusAI2" Text="AI ✓" FontSize="9" Foreground="#4CAF50" VerticalAlignment="Center"/>
                            <TextBlock Text="  " FontSize="9" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusParts2" Text="标准件 ✓" FontSize="9" Foreground="#4CAF50" VerticalAlignment="Center"/>
                            <TextBlock Text="  " FontSize="9" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusLib2" Text="模型库 ✓" FontSize="9" Foreground="#4CAF50" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="FooterSettingsBtn2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,2"
                                Click="FooterSettingsBtn_Click" ToolTip="系统设置">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#888888"/>
                        </Button>
                    </Grid>
                </Grid>
                <!-- Row 1: update detail panel (hidden by default) -->
                <StackPanel x:Name="UpdatePanel" Grid.Row="1" Visibility="Collapsed" Background="White" Margin="10,8">
                    <TextBlock x:Name="UpdateTitle" Text="" FontSize="11" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,4"/>
                    <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="UpdateNotes" Text="" FontSize="10" Foreground="#666666" TextWrapping="Wrap"/>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="UpdateNowBtn" Content="立即更新" Click="UpdateNowBtn_Click"
                                Style="{StaticResource PrimaryBtn}" Padding="12,4" Margin="0,0,6,0"/>
                        <Button x:Name="UpdateLaterBtn" Content="稍后提醒" Click="UpdateLaterBtn_Click"
                                Style="{StaticResource SecondaryBtn}" Padding="12,4"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
